# Base URL backend Schooly Shop.
# Kosongkan untuk memakai route handler lokal Next.js di /api.
# Contoh backend eksternal: https://api.schoolyshop.example.com
NEXT_PUBLIC_API_URL=

# Gunakan akun demo lokal selama endpoint /auth belum tersedia.
# Set ke "false" setelah backend auth siap.
NEXT_PUBLIC_USE_MOCK_AUTH=true

# Gunakan route mock admin lokal hanya saat backend admin tidak tersedia.
NEXT_PUBLIC_USE_MOCK_ADMIN=false

# Opsional: override URL backend khusus admin.
NEXT_PUBLIC_ADMIN_API_URL=
